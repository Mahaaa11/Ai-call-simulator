# Fichier de connexion MySQL — Simulateur d'appels IA
# Copiez en connexion_mysql.env et adaptez si besoin.

MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=call_simulator
MYSQL_DATABASE=call_simulator

# URL de l'API conversations (pour Streamlit Cloud / hébergement)
# Local : http://127.0.0.1:8766
# Railway / VPS : https://votre-api.railway.app
CONVERSATION_API_URL=http://127.0.0.1:8766
