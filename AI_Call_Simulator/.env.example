# Copiez ce fichier en .env à la racine du projet

# Simulateur web (OpenRouter + Nemotron) — https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-...

# Transcription appels réels (Streamlit Ollama) — https://www.assemblyai.com
ASSEMBLYAI_API_KEY=

# MySQL simulateur web — voir aussi web/.env.example
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=call_simulator
MYSQL_DATABASE=call_simulator
