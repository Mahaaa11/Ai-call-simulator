OPENROUTER_API_KEY=sk-or-v1-...

# MySQL — voir config/connexion_mysql.env
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=call_simulator
MYSQL_DATABASE=call_simulator
